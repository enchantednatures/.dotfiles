{
  "$schema": "https//opencode.ai/config.json",
  "autoupdate": true,
  "provider": {},
  "model": "opencode-go/kimi-k2.5",
  "small_model": "opencode-go/kimi-k2.5",
  "permission": {
    "*": "allow",
    "external_directory": {
      "/tmp/*": "allow"
    },
    "read": {
      "~/Developer/**/*": "allow",
      "~/source/**/*": "allow"
    }
  },
  "mcp": {
    "kubernetes": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@latest"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "temperature": 0.3,
      "model": "opencode-go/kimi-k2.5",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git rev-parse*": "allow",
          "ls*": "allow",
          "pwd": "allow",
          "grep*": "allow",
          "rg*": "allow",
          "find*": "allow",
          "fd*": "allow",
          "cat*": "allow",
          "head*": "allow",
          "tail*": "allow",
          "kubectl get*": "allow",
          "kubectl describe*": "allow",
          "kubectl logs*": "allow",
          "kubectl top*": "allow"
        },
        "webfetch": "allow"
      },
      "color": "primary"
    }
  },
  "plugin": [
    "oh-my-openagent@latest"
  ]
}
