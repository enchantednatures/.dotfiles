{
  "$schema": "https//opencode.ai/config.json",
  "autoupdate": true,
  "provider": {},
  "model": "opencode-go/kimi-k2.5",
  "small_model": "opencode-go/kimi-k2.5",
  "permission": {
    "*": "allow",
    "external_directory": {
      "/tmp/*": "allow"
    },
    "read": {
      "~/Developer/**/*": "allow",
      "~/source/**/*": "allow"
    }
  },
  "mcp": {
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "kubernetes-mcp-server@latest"]
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "temperature": 0.3,
      "model": "opencode/kimi-k2.5",
      "prompt": "{file:./agents/build.md}",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "ls*": "allow",
          "pwd": "allow"
        },
        "webfetch": "ask"
      },
      "color": "primary"
    },
    "plan": {
      "mode": "primary",
      "temperature": 0.1,
      "model": "opencode/kimi-k2.5",
      "prompt": "{file:./agents/plan.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "ls*": "allow",
          "pwd": "allow",
          "grep*": "allow",
          "find*": "allow"
        },
        "webfetch": "allow"
      },
      "color": "secondary"
    },
    "security": {
      "mode": "subagent",
      "description": "Security specialist - Identifies vulnerabilities and validates security controls",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      },
      "color": "error"
    },
    "performance": {
      "mode": "subagent",
      "description": "Performance specialist - Identifies bottlenecks and suggests optimizations",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      },
      "color": "warning"
    },
    "architecture": {
      "mode": "subagent",
      "description": "Architecture specialist - Reviews system design against requirements and best practices",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      },
      "color": "accent"
    },
    "api-design": {
      "mode": "subagent",
      "description": "API design specialist - Designs REST, GraphQL, and gRPC APIs following best practices",
      "temperature": 0.3,
      "permission": {
        "edit": "ask",
        "bash": "deny",
        "webfetch": "allow"
      },
      "color": "info"
    },
    "data-model": {
      "mode": "subagent",
      "description": "Data modeling specialist - Designs database schemas and entity relationships",
      "temperature": 0.2,
      "permission": {
        "edit": "ask",
        "bash": "deny",
        "webfetch": "allow"
      },
      "color": "success"
    },
    "refactor": {
      "mode": "subagent",
      "description": "Refactoring specialist - Safely improves code structure while preserving behavior",
      "temperature": 0.2,
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git log*": "allow",
          "git diff*": "allow"
        }
      },
      "color": "accent"
    },
    "test": {
      "mode": "subagent",
      "description": "Test specialist - Designs and implements comprehensive test strategies",
      "temperature": 0.2,
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "npm test": "allow",
          "yarn test": "allow",
          "pnpm test": "allow",
          "cargo test": "allow",
          "go test": "allow",
          "pytest": "allow",
          "jest": "allow",
          "vitest": "allow"
        }
      },
      "color": "success"
    },
    "docs": {
      "mode": "subagent",
      "description": "Documentation specialist - Creates and maintains clear, comprehensive documentation",
      "temperature": 0.4,
      "permission": {
        "edit": "ask",
        "bash": "deny",
        "webfetch": "allow"
      },
      "color": "info"
    }
  }
}
